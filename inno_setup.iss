[Code]
var
  WorldPage: TInputOptionWizardPage;
  ComponentsLabel: TNewStaticText;

procedure InitializeWizard;
begin
  // Add custom disclaimer to Components page
  ComponentsLabel := TNewStaticText.Create(WizardForm);
  ComponentsLabel.Parent := WizardForm.SelectComponentsPage;
  ComponentsLabel.Top := WizardForm.SelectComponentsLabel.Top;
  ComponentsLabel.Left := WizardForm.SelectComponentsLabel.Left;
  ComponentsLabel.Width := WizardForm.SelectComponentsLabel.Width + ScaleX(70);
  ComponentsLabel.Height := WizardForm.SelectComponentsLabel.Height;
  ComponentsLabel.AutoSize := False;
  ComponentsLabel.WordWrap := True;
  ComponentsLabel.Font.Style := [fsBold];
  ComponentsLabel.Font.Color := clRed;
  ComponentsLabel.Caption := 'IMPORTANT: These modules are for playing MultiWorlds with your own legally obtained copies of the games listed. They WILL NOT install the game. Free games shown in BOLD';

  WorldPage := CreateInputOptionPage(wpSelectTasks,
    'Select Age Rating for Games List', 
    'Choose the age rating for the games list to use initially. The options are: 12+, 16+, and NR (Not Rated). Not rated games are suitable for 18 or simply games that are unknown. Note that adult only games are not found in these indexes.',
    'Select one of the following age ratings for the initial games list. This setting can be changed later.', 
    True, False);

  WorldPage.Add('PEGI 12');
  WorldPage.Add('PEGI 16');
  WorldPage.Add('NR');

  // Set default to sixteen (index 1)
  WorldPage.SelectedValueIndex := 1;
end;

function GetSelectedVariantToken: String;
begin
  // Maps the WorldPage rating selection to the bare wheel_cache\mwgg_igdb_variant.txt
  // token (contract with the runtime's wheel_cache.consuming resolver).
  if WorldPage.SelectedValueIndex = 0 then
    Result := 'twelve'
  else if WorldPage.SelectedValueIndex = 1 then
    Result := 'sixteen'
  else
    Result := 'nr';
end;

function ShouldShowDeleteLibTask: Boolean;
begin
  Result := DirExists(ExpandConstant('{app}\lib'));
end;

function IsUpdaterRelaunch: Boolean;
begin
  Result := ExpandConstant('{param:relaunch|0}') = '1';
end;

function IsUvInstalled: Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(ExpandConstant('{cmd}'), '/c where uv', '', SW_HIDE, ewWaitUntilTerminated, ResultCode)
            and (ResultCode = 0);
  if Result then
    Log('uv found on PATH')
  else
    Log('uv not found on PATH; will install');
end;

function IsWingetAvailable: Boolean;
var
  ResultCode: Integer;
begin
  Result := False;
  if Exec(ExpandConstant('{cmd}'), '/c where winget', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0) then
  begin
    Log('winget available');
    Result := True;
  end
  else
    Log('winget not available; will fall back to astral PowerShell installer');
end;

function IsUvNeededViaWinget: Boolean;
begin
  Result := (not IsUvInstalled) and IsWingetAvailable;
end;

function IsUvNeededViaPwsh: Boolean;
begin
  Result := (not IsUvInstalled) and (not IsWingetAvailable);
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  WheelCacheDir: String;
begin
  if CurStep = ssInstall then
  begin
    if WizardIsTaskSelected('deletelib') then
      DelTree(ExpandConstant('{app}\lib'), True, True, True);
  end
  else if CurStep = ssPostInstall then
  begin
    // wheel_cache must exist even with zero components selected, so the
    // variant marker always arrives for the runtime's first-launch install.
    WheelCacheDir := ExpandConstant('{app}\wheel_cache');
    ForceDirectories(WheelCacheDir);
    SaveStringToFile(WheelCacheDir + '\mwgg_igdb_variant.txt', GetSelectedVariantToken, False);
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
var
  InClientList: TStringList;
  i: Integer;
begin
  if CurPageID = wpSelectComponents then
  begin
    // Bold the description of any in-client world. The descriptions list is
    // injected at compile time by the regenerator; matching is by description
    // text since TNewCheckListBox stores the visible caption, not the
    // component name.
    InClientList := TStringList.Create;
    try
      InClientList.CommaText := '{#InClientDescriptions}';
      for i := 0 to WizardForm.ComponentsList.Items.Count - 1 do
      begin
        if InClientList.IndexOf(WizardForm.ComponentsList.Items[i]) >= 0 then
          WizardForm.ComponentsList.ItemFontStyle[i] := [fsBold];
      end;
    finally
      InClientList.Free;
    end;
  end;
end;
