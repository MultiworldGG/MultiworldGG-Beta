[Dirs]
NAME: "{app}"; Flags: setntfscompression; Permissions: everyone-modify users-modify authusers-modify;
; Explicit grant (not relied on via {app} ACL inheritance): the real-user first-launch
; process renames this dir to wheel_cache.consuming and later deletes it, which needs
; delete rights on the dir itself, not just write access to its contents.
NAME: "{app}\wheel_cache"; Permissions: everyone-modify users-modify authusers-modify;

[Files]
Source: "{#source_path}\*"; Excludes: "*.sfc, *.log, SNI, EnemizerCLI"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; Excluded above (the build dir also carries data\SNI and data\EnemizerCLI); ship the root copies only.
Source: "{#source_path}\SNI\*"; Excludes: "*.sfc, *.log"; DestDir: "{app}\SNI"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#source_path}\EnemizerCLI\*"; Excludes: "*.sfc, *.log"; DestDir: "{app}\EnemizerCLI"; Flags: ignoreversion recursesubdirs createallsubdirs

