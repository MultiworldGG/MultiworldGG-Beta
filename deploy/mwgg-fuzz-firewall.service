# Re-apply the mwgg-fuzz-egress bridge firewall after Docker starts.
#
# DOCKER-USER rules survive `docker` daemon restarts but NOT a host reboot (the
# kernel's iptables are cleared). This oneshot re-applies them once Docker is up
# and has recreated the bridge.
#
#   sudo install -m 0755 fuzz-egress-firewall.sh /usr/local/sbin/
#   sudo install -m 0644 mwgg-fuzz-firewall.service /etc/systemd/system/
#   sudo systemctl enable --now mwgg-fuzz-firewall.service
#
# To also block the host's public IP(s), add a drop-in:
#   sudo systemctl edit mwgg-fuzz-firewall.service
#   [Service]
#   Environment=MWGG_FUZZ_BLOCK_IPS=203.0.113.5
[Unit]
Description=Firewall the mwgg-fuzz-egress bridge (block host, LAN, cloud metadata)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fuzz-egress-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
