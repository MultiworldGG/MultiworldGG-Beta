# Webhost runtime secrets.
#
# Copy to web.env (chmod 0600, gitignored) and fill in real random values.
# `docker-compose up` won't bring the `web` service up without this file
# present — see docker-compose.yml `env_file: ./web.env`.
#
# Generate values with: openssl rand -hex 32

# Signs Flask session cookies. Rotating this invalidates every active
# session — users will be logged out, but the underlying DB rows
# (rooms / seeds / lobbies) keep their owner UUIDs.
MWGG_SECRET_KEY=replace-me-with-openssl-rand-hex-32

# Optional. Derives the WebAuthn user-handle the OS passkey picker uses to
# group multiple passkeys for the same MultiworldGG session. Falls back to
# MWGG_SECRET_KEY if unset, which is fine for most deployments. Rotate this
# separately if you want to refresh the OS clustering without invalidating
# session cookies.
#MWGG_WEBAUTHN_HANDLE_SECRET=
